{
  "manifest_version": 3,
  "name": "LeetSync",
  "description": "Automatically sync accepted LeetCode submissions to GitHub.",
  "version": "0.1.5",
  "key": "",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://api.leetsync.app/*",
    "https://leetsync-nitishypujar.onrender.com/*",
    "https://leetcode.com/*",
    "https://leetcode.cn/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*",
      "https://leetsync-nitishypujar.onrender.com/*",
      "https://app.leetsync.app/*"
    ]
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "LeetSync" },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
