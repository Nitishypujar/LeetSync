NODE_ENV=development
PORT=3000
RUN_SYNC_WORKER=false
GITHUB_AUTH_MODE=oauth
DATABASE_URL=postgresql://leetsync:leetsync@postgres:5432/leetsync?schema=public
# Optional CA certificate path for PostgreSQL servers with a private CA.
# Supabase database hosts use the bundled, verified Supabase root CA automatically.
# DATABASE_SSL_ROOT_CERT=./certs/custom-postgres-root.crt
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
# Set GITHUB_AUTH_MODE=github_app only after registering the GitHub App.
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=leetsync-app
# GITHUB_APP_PRIVATE_KEY=replace-with-private-key-pem
# TOKEN_ENCRYPTION_KEY_PREVIOUS=old-64-character-hex-key-during-migration
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
FRONTEND_ORIGIN=http://localhost:5173
EXTENSION_ID=nadlcboffmafknogdcgohdcledaomppo
VITE_API_BASE_URL=http://localhost:3000
VITE_EXTENSION_ID=nadlcboffmafknogdcgohdcledaomppo
