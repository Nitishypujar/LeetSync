{
  "name": "leetsync",
  "private": true,
  "version": "0.1.0",
  "description": "LeetSync foundation monorepo",
  "workspaces": ["backend", "shared"],
  "scripts": {
    "dev:api": "npm run dev -w backend",
    "dev:worker": "npm run worker -w backend",
    "build": "npm run build -ws",
    "typecheck": "npm run typecheck -ws",
    "lint": "npm run lint -ws",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test -w backend",
    "db:generate": "npm run prisma:generate -w backend",
    "db:migrate": "npm run prisma:migrate -w backend",
    "db:deploy": "npm run prisma:deploy -w backend",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "engines": { "node": ">=20" }
}
